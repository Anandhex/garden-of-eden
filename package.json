{
  "name": "llm-game",
  "version": "0.1.0",
  "private": true,
  "description": "LLM-driven NPCs running locally on Ollama",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "chat": "tsx --env-file-if-exists=.env packages/server/src/cli.ts",
    "web": "npm run build -w @millbrook/client && tsx --env-file-if-exists=.env packages/server/src/web/server.ts",
    "web:voices": "tsx packages/server/scripts/voices.ts web",
    "dev": "tsx packages/server/scripts/dev.ts",
    "voices:install": "tsx packages/server/scripts/voices.ts install",
    "voices": "tsx packages/server/scripts/voices.ts serve",
    "build": "npm run build -w @millbrook/client",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run packages/server/tests/live.test.ts",
    "bench": "tsx packages/server/scripts/bench.ts",
    "bench:voice": "tsx --env-file-if-exists=.env packages/server/scripts/bench-voice.ts",
    "sim": "tsx packages/server/scripts/sim.ts",
    "sim:realm": "tsx packages/server/scripts/sim-realm.ts",
    "sim:lives": "tsx packages/server/scripts/sim-lives.ts",
    "replay": "tsx packages/server/scripts/replay.ts",
    "world:export": "tsx packages/server/scripts/world.ts export",
    "world:import": "tsx packages/server/scripts/world.ts import",
    "bench:storage": "tsx packages/server/scripts/bench-storage.ts",
    "bench:busy": "tsx --env-file-if-exists=.env packages/server/scripts/bench-busy.ts",
    "bench:traits": "tsx packages/server/scripts/bench-traits.ts",
    "bench:director": "tsx packages/server/scripts/bench-director.ts",
    "bench:reviews": "tsx --env-file-if-exists=.env packages/server/scripts/bench-reviews.ts",
    "gen": "tsx --env-file-if-exists=.env packages/server/scripts/generate-npc.ts",
    "check-npcs": "tsx packages/server/scripts/check-npcs.ts",
    "bench:style": "tsx --env-file-if-exists=.env packages/server/scripts/bench-style.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
