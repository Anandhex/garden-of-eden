# Copy to .env to override defaults (optional).
# OLLAMA_HOST=http://localhost:11434
# NPC_MODEL=qwen3:4b-instruct

# NPC voices (optional, see README "NPC voices"). `npm run web:voices` sets PIPER_URL for you.
# PIPER_URL=http://127.0.0.1:5055/synthesize
# PIPER_PORT=5055
# Milliseconds of silence before an NPC says a filler line ("Hold on."); 0 turns them off.
# FILLER_AFTER_MS=3000

# Families (N11.3): NPCs court, marry and have children. `off` stops it among NPCs.
# NPC_MARRIAGE=on
# The admin page (/admin, N17) answers only to this machine; ADMIN=on skips that check (behind your own proxy)
# ADMIN=on
# Days from expecting to birth (default 9, three quarters of a 12-day year).
# PREGNANCY_DAYS=9
# Lets the player court and marry an NPC who's open to it.
# ROMANCE=on
